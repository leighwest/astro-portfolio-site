---
import { getCollection } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Blog | Leigh West"
  description="Thoughts on backend engineering, Kubernetes, GitOps, and the path toward platform and solutions engineering."
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Blog"
        tagline="Notes on engineering, infrastructure, and everything in between."
        align="start"
      />
      <ul class="grid" role="list">
        {
          posts.map((post) => (
            <li class="article">
              <div class="article__inner">
                <div class="article__head">
                  {post.data.img && (
                    <div class="image-wrap">
                      <a class="article__image" href={`/blog/${post.id}`}>
                        <img
                          src={post.data.img}
                          alt={post.data.img_alt || ''}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    </div>
                  )}
                </div>
                <div class="article__content">
                  {post.data.tags.length > 0 && (
                    <div class="article-tags__box">
                      {post.data.tags.map((t) => (
                        <Pill>{t}</Pill>
                      ))}
                    </div>
                  )}
                  <h2 class="article__title">
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h2>
                  <p class="article__excerpt">{post.data.description}</p>
                  <div class="article__meta">
                    <div class="article-info">
                      <time datetime={post.data.publishDate.toISOString()}>
                        {post.data.publishDate.toLocaleDateString('en-AU', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    row-gap: 32px;
    max-width: 1180px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    margin: 0 16px 32px 16px;
    overflow: hidden;
    background: var(--gradient-subtle);
    transition: box-shadow var(--theme-transition);
  }

  .article__inner:hover {
    box-shadow: var(--shadow-md);
  }

  .image-wrap {
    overflow: hidden;
  }

  .article__image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    transition: transform 0.3s ease;
  }

  .article__inner:hover .article__image img {
    transform: scale(1.03);
  }

  .article__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    flex: 1;
  }

  .article-tags__box {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .article-tags__box :global(.pill) {
    font-size: var(--text-sm);
    padding: 0.25rem 0.625rem;
  }

  .article__title {
    font-size: var(--text-lg);
    line-height: 1.3;
    min-height: 3.8em;
    margin: 0;
  }

  .article__title a {
    color: var(--gray-0);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .article__title a:hover {
    color: var(--accent-regular);
  }

  .article__excerpt {
    font-size: var(--text-sm);
    color: var(--gray-400);
    flex: 1;
    margin: 0;
  }

  .article__meta {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--gray-800);
  }

  .article-info time {
    font-size: var(--text-sm);
    color: var(--gray-500);
  }

  .article {
    opacity: 0;
    animation: fadeUp 0.8s ease-out both;
    animation-delay: 5s;
  }

  .article:nth-child(1) {
    animation-delay: 0.1s;
  }
  .article:nth-child(2) {
    animation-delay: 0.3s;
  }
  .article:nth-child(3) {
    animation-delay: 0.5s;
  }
  .article:nth-child(4) {
    animation-delay: 0.7s;
  }
  .article:nth-child(5) {
    animation-delay: 0.9s;
  }
  .article:nth-child(6) {
    animation-delay: 1.1s;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(35px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 60em) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40em) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

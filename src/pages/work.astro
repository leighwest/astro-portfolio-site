---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="My Work | Leigh West"
	description="Learn about Leigh West's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="See my most recent projects below to get an idea of my past experience."
				align="start"
			/>
			<Grid>
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	main :global(li) {
		animation: fadeUp 0.8s ease-out both;
	}
	main :global(li:nth-child(1)) {
		animation-delay: 0.1s;
	}
	main :global(li:nth-child(2)) {
		animation-delay: 0.3s;
	}
	main :global(li:nth-child(3)) {
		animation-delay: 0.5s;
	}
	main :global(li:nth-child(4)) {
		animation-delay: 0.7s;
	}
	main :global(li:nth-child(5)) {
		animation-delay: 0.9s;
	}
	main :global(li:nth-child(6)) {
		animation-delay: 1.1s;
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(70px);
			animation-delay: 5s;
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About | Leigh West"
	description="About Leigh West Lorem Ipsum"
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read on to learn a bit about me and my background."
			>
				<!-- <img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Leigh West at work with a colleague"
				/> -->
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a backend engineer based in Melbourne, working primarily in Java
						and Spring Boot, with a few years of production experience building
						services that run on Kubernetes and ship through GitOps pipelines
						with Flux and Kustomize.
					</p>
					<p>
						What I've come to enjoy most isn't the code itself — it's the
						conversations around it. Explaining why a particular tradeoff
						matters, helping a team align on an approach, or breaking down a
						complex problem so it stops feeling overwhelming. The parts of
						engineering that involve people.
					</p>
					<p>
						That's why I'm increasingly drawn to platform engineering and
						solutions-focused roles — work that sits at the intersection of deep
						technical knowledge and client-facing communication. I came up
						through a CS degree and spent the early years heads-down on backend
						systems, but the throughline of every project I've valued has been
						the same: making complexity feel manageable for the people who have
						to live with it.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<div class="education-entry">
						<h3>Bachelor of Computer Science (Software Development)</h3>
						<p class="meta">University of New England · 2018–2021</p>
						<p>GPA 6.86/7</p>
						<p>
							Vice-Chancellor's Scholar — awarded to the university's most
							academically high-achieving graduates.
						</p>
					</div>

					<div class="education-entry">
						<h3>Earlier: Exercise Science</h3>
						<p class="meta">
							Deakin University & Australian Catholic University · 2007–2011
						</p>
						<p>
							Bachelor's degree in Exercise and Sport Science, followed by
							postgraduate study in Applied Exercise Science. A previous career
							that taught me how to explain complex ideas in plain language and
							work directly with people — habits that have proven just as useful
							in software.
						</p>
					</div>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<h3 class="skills-group-title">Languages & frameworks</h3>
					<div class="tags">
						<span class="tag">Java</span>
						<span class="tag">Spring Boot</span>
						<span class="tag">TypeScript</span>
						<span class="tag">React</span>
						<span class="tag">Kotlin</span>
					</div>

					<h3 class="skills-group-title">Cloud & infrastructure</h3>
					<div class="tags">
						<span class="tag">Kubernetes</span>
						<span class="tag">Kustomize</span>
						<span class="tag">Flux</span>
						<span class="tag">GitOps</span>
						<span class="tag">AWS</span>
						<span class="tag">Docker</span>
						<span class="tag">CI/CD</span>
					</div>

					<h3 class="skills-group-title">Practices</h3>
					<div class="tags">
						<span class="tag">API design</span>
						<span class="tag">Testing</span>
						<span class="tag">DevOps</span>
						<span class="tag">Cloud-native architecture</span>
						<span class="tag">Technical communication</span>
					</div>
				</div>
			</section>
		</main>
		<div class="wrapper">
			<ContactCTA />
		</div>
	</div>

	<style>
		.about {
			display: flex;
			flex-direction: column;
			gap: 3.5rem;
		}

		img {
			margin-top: 1.5rem;
			border-radius: 1.5rem;
			box-shadow: var(--shadow-md);
		}

		section {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			color: var(--gray-200);
		}

		.section-title {
			grid-column-start: 1;
			font-size: var(--text-xl);
			color: var(--gray-0);
		}

		.content {
			grid-column: 2 / 4;
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		.content :global(a) {
			text-decoration: 1px solid underline transparent;
			text-underline-offset: 0.25em;
			transition: text-decoration-color var(--theme-transition);
		}

		.content :global(a:hover),
		.content :global(a:focus) {
			text-decoration-color: currentColor;
		}

		.education-entry {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}

		.education-entry + .education-entry {
			margin-top: 1.5rem;
		}

		.education-entry h3 {
			font-size: var(--text-md);
			color: var(--gray-0);
			margin: 0;
		}

		.meta {
			color: var(--gray-400);
			font-size: var(--text-base);
		}

		.skills-group-title {
			font-size: var(--text-md);
			color: var(--gray-0);
			margin: 1.5rem 0 0 0;
			font-family: var(--font-brand);
			font-weight: 500;
		}

		.skills-group-title:first-child {
			margin-top: 0;
		}

		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.tag {
			padding: 0.25rem 0.75rem;
			border-radius: 999px;
			font-size: var(--text-sm);
			font-family: var(--font-body);
			font-weight: 400;
			background: var(--gray-800);
			color: var(--gray-300);
		}

		@media (min-width: 50em) {
			.about {
				display: grid;
				grid-template-columns: 1fr 60% 1fr;
			}

			.about > :global(:first-child) {
				grid-column-start: 2;
			}

			section {
				display: contents;
				font-size: var(--text-lg);
			}
		}
	</style>
</BaseLayout>

---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About | Leigh West"
	description="About Leigh West Lorem Ipsum"
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read on to learn a bit about me and my background."
			>
				<!-- <img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Leigh West at work with a colleague"
				/> -->
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a backend engineer based in Melbourne, working primarily in Java
						and Spring Boot, with a few years of production experience building
						services that run on Kubernetes and ship through GitOps pipelines
						with Flux and Kustomize.
					</p>
					<p>
						What I've come to enjoy most isn't the code itself — it's the
						conversations around it. Explaining why a particular tradeoff
						matters, helping a team align on an approach, or breaking down a
						complex problem so it stops feeling overwhelming. The parts of
						engineering that involve people.
					</p>
					<p>
						That's why I'm increasingly drawn to platform engineering and
						solutions-focused roles — work that sits at the intersection of deep
						technical knowledge and client-facing communication. I came up
						through a CS degree and spent the early years heads-down on backend
						systems, but the throughline of every project I've valued has been
						the same: making complexity feel manageable for the people who have
						to live with it.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>Corporis voluptates tenetur laudantium.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>officia unde omnis</p>
				</div>
			</section>
		</main>
		<div class="wrapper">
			<ContactCTA />
		</div>
	</div>

	<style>
		.about {
			display: flex;
			flex-direction: column;
			gap: 3.5rem;
		}

		img {
			margin-top: 1.5rem;
			border-radius: 1.5rem;
			box-shadow: var(--shadow-md);
		}

		section {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			color: var(--gray-200);
		}

		.section-title {
			grid-column-start: 1;
			font-size: var(--text-xl);
			color: var(--gray-0);
		}

		.content {
			grid-column: 2 / 4;
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		.content :global(a) {
			text-decoration: 1px solid underline transparent;
			text-underline-offset: 0.25em;
			transition: text-decoration-color var(--theme-transition);
		}

		.content :global(a:hover),
		.content :global(a:focus) {
			text-decoration-color: currentColor;
		}

		@media (min-width: 50em) {
			.about {
				display: grid;
				grid-template-columns: 1fr 60% 1fr;
			}

			.about > :global(:first-child) {
				grid-column-start: 2;
			}

			section {
				display: contents;
				font-size: var(--text-lg);
			}
		}
	</style>
</BaseLayout>
